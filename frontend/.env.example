# Copia este archivo como .env. NUNCA subas el .env al repositorio.
# Solo las variables que empiezan con VITE_ llegan al navegador:
# aquí nunca van contraseñas ni claves secretas.

# URL del backend FastAPI (en local: uvicorn en el puerto 8000).
# El frontend solo habla con el backend; nunca con la base de datos.
VITE_API_URL=http://localhost:8000/api/v1

# Copia este archivo como .env. NUNCA subas el .env al repositorio.
# Solo las variables que empiezan con VITE_ llegan al navegador:
# aquí nunca van contraseñas ni claves secretas.

# URL del backend FastAPI. Déjala comentada: por defecto el frontend usa "/api/v1"
# y Vite lo reenvía al backend en http://localhost:8000 (funciona también desde
# otros equipos de la red con "npm run dev -- --host").
# Solo se define si el backend está en otra dirección (por ejemplo, en la nube).
# El frontend solo habla con el backend; nunca con la base de datos.
# VITE_API_URL=https://mi-backend.ejemplo.com/api/v1

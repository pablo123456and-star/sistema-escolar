# Copia este archivo como .env y completa los valores. NUNCA subas el .env al repositorio.

# --- Base de datos --------------------------------------------------------
# PostgreSQL local (desarrollo): base creada con los scripts de basededato/sql
DATABASE_URL=postgresql+asyncpg://postgres:TU_CONTRASENA@localhost:5432/escuela

# Si usan Supabase como hosting: botón "Connect" > "Transaction pooler" (puerto 6543)
# y cambia el prefijo "postgresql://" por "postgresql+asyncpg://":
# DATABASE_URL=postgresql+asyncpg://postgres.TU_PROYECTO:TU_CONTRASENA@aws-0-TU_REGION.pooler.supabase.com:6543/postgres

# --- Login (token JWT propio) -----------------------------------------------
# Clave secreta para firmar los tokens: larga y aleatoria. Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cada integrante usa la suya en local; en producción se configura en el servidor.
JWT_SECRETO=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
# Minutos que dura una sesión antes de volver a iniciar sesión
JWT_MINUTOS=480

# --- API --------------------------------------------------------------------
# Orígenes que pueden llamar a la API (el frontend en local)
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Recuperación de contraseña y correo electrónico -----------------------
# Minutos de validez del enlace temporal de un solo uso (por defecto 15)
TOKEN_RECUPERACION_MINUTOS=15

# Configuración SMTP para envío real de correos (ej. Gmail, Mailtrap, Outlook, SendGrid)
# Si se dejan vacíos, el sistema funciona en modo local/desarrollo imprimiendo el enlace
# en la consola/terminal del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=noreply@mariscalsucreg.edu.bo
SMTP_USAR_TLS=true
CORREO_EN_CONSOLA=true
